{
  "name": "@dropinnodex/server",
  "version": "0.8.0",
  "description": "Server-side SDK for dropin-activity — mint HS256 user tokens offline, and manage users, feeds, and webhooks from your backend. Node only.",
  "keywords": [
    "dropin",
    "activity-feed",
    "feed",
    "webhooks",
    "jwt",
    "sdk",
    "getstream"
  ],
  "license": "MIT",
  "author": "Marko Pavic",
  "homepage": "https://docs.getnodex.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropinnodex/dropin-sdks.git",
    "directory": "packages/server"
  },
  "bugs": {
    "url": "https://github.com/dropinnodex/dropin-sdks/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@dropinnodex/client": "workspace:^",
    "jose": "^6.2.3"
  }
}
