{
  "name": "@dropinnodex/client",
  "version": "0.1.0",
  "description": "Isomorphic, zero-dependency client SDK for dropin-activity — feeds, activities, reactions, and follows over fetch. Browser or Node.",
  "keywords": ["dropin", "activity-feed", "feed", "reactions", "follows", "sdk", "getstream", "isomorphic"],
  "license": "MIT",
  "author": "Marko Pavic",
  "homepage": "https://docs.getnodex.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropinnodex/dropin-sdks.git",
    "directory": "packages/client"
  },
  "bugs": {
    "url": "https://github.com/dropinnodex/dropin-sdks/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": { "types": "./dist/index.d.ts", "default": "./dist/index.js" },
      "require": { "types": "./dist/index.d.cts", "default": "./dist/index.cjs" }
    }
  },
  "files": ["dist"],
  "publishConfig": {
    "access": "public"
  },
  "scripts": { "build": "tsup" }
}
