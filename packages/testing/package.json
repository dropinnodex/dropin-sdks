{
  "name": "@dropinnodex/testing",
  "version": "0.2.0",
  "description": "In-memory dropin for tests — a fetch-compatible fake of the API, so the real client and hooks run unchanged with no network and no live tenant.",
  "keywords": [
    "dropin",
    "activity-feed",
    "testing",
    "fake",
    "in-memory",
    "sdk"
  ],
  "license": "MIT",
  "author": "Marko Pavic",
  "homepage": "https://docs.getnodex.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropinnodex/dropin-sdks.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/dropinnodex/dropin-sdks/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "devDependencies": {
    "@dropinnodex/client": "workspace:^"
  }
}
