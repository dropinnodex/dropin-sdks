{
  "name": "@dropinnodex/react",
  "version": "0.13.0",
  "description": "React hooks for dropin-activity — feeds, reactions, and follows with optimistic updates and rollback.",
  "keywords": [
    "dropin",
    "activity-feed",
    "feed",
    "react",
    "hooks",
    "sdk",
    "getstream",
    "optimistic"
  ],
  "license": "MIT",
  "author": "Marko Pavic",
  "homepage": "https://docs.getnodex.cloud",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dropinnodex/dropin-sdks.git",
    "directory": "packages/react"
  },
  "bugs": {
    "url": "https://github.com/dropinnodex/dropin-sdks/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "@dropinnodex/client": "workspace:^"
  },
  "peerDependencies": {
    "react": ">=18"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "jsdom": "^29.1.1",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  }
}
